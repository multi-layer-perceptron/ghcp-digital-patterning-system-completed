<UserControl x:Class="PatterningOperatorDashboard.Views.ReportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="16">
    <TextBlock Text="Report Export" FontSize="20" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Export JSON" Width="110" Margin="0,0,8,0" />
      <Button Content="Export HTML" Width="110" />
    </StackPanel>
    <TextBlock Text="{Binding LastExportPath}" Margin="0,12,0,0" />
  </StackPanel>
</UserControl>
