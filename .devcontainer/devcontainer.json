{
    "name": "Digital Patterning Workshop",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "forwardPorts": [
        5120,
        5130,
        5432
    ],
    "portsAttributes": {
        "5120": {
            "label": "PLC gateway stub"
        },
        "5130": {
            "label": "FPGA gateway stub"
        },
        "5432": {
            "label": "PostgreSQL"
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "moby": false,
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/powershell:2": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/azure-cli:1": {
            "version": "latest"
        },
        "ghcr.io/azure/azure-dev/azd:0": {},
        "ghcr.io/devcontainers/features/terraform:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "8.0"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
            "packages": "postgresql-client,jq,less,cmake,build-essential,ghdl,sqlite3"
        },
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest"
        }
    },
    "postCreateCommand": "az bicep install && sudo npm install -g @modelcontextprotocol/inspector && python -m pip install --user uv && python -m uv tool install --force specify-cli --from git+https://github.com/github/spec-kit.git@v0.8.11 && (gh extension install github/gh-copilot || true)",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "ms-azuretools.vscode-containers",
                "ms-azuretools.vscode-azureresourcegroups",
                "ms-azuretools.vscode-azureappservice",
                "ms-azuretools.vscode-azurefunctions",
                "ms-azuretools.vscode-azure-github-copilot",
                "ms-azuretools.vscode-bicep",
                "HashiCorp.terraform",
                "ckolkman.vscode-postgres",
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "GitHub.vscode-pull-request-github",
                "GitHub.vscode-github-actions"
            ]
        }
    }
}
